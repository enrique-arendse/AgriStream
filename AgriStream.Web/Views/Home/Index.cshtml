@model List<AgriStream.Web.Controllers.HomeController.TelemetryDto>
<h1>Farm operations dashboard</h1>
@if(TempData["Message"]!=null){<div class="alert alert-info">@TempData["Message"]</div>}
<p>Latest sensor readings returned by the HTTP GET Azure Function.</p>
<table class="table table-striped"><thead><tr><th>Device</th><th>Timestamp</th><th>Moisture</th><th>Temperature</th></tr></thead><tbody>
@foreach(var item in Model){<tr><td>@item.deviceId</td><td>@item.timestamp</td><td>@item.moisture</td><td>@item.temperature</td></tr>}
</tbody></table>
<h2>Trigger irrigation</h2><form asp-action="Irrigate" method="post"><div class="mb-2"><label>Device ID</label><input class="form-control" name="deviceId" required/></div><div class="mb-2"><label>Duration (minutes)</label><input class="form-control" type="number" name="durationMinutes" min="1" max="120" value="10"/></div><div class="mb-2"><label>Reason</label><input class="form-control" name="reason" value="Manual dashboard request"/></div><button class="btn btn-success">Queue irrigation command</button></form>
<p class="mt-3"><a asp-controller="Media" asp-action="Upload">Upload drone image</a></p>
<form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary">Sign out</button></form>
